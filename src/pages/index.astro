---
// 单页个人主页：顶栏 + 4 个板块，锚点定位 + 滚动自动高亮
const sections = [
  { id: 'about', label: '关于我' },
  { id: 'skills', label: '技能' },
  { id: 'projects', label: '项目' },
  { id: 'contact', label: '联系' },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>我的个人主页</title>
  </head>
  <body>
    <header class="navbar">
      <span class="brand">My Home</span>
      <nav>
        {sections.map((s) => (
          <a href={`#${s.id}`} data-target={s.id}>{s.label}</a>
        ))}
      </nav>
    </header>

    <main>
      {sections.map((s) => (
        <section id={s.id}>
          <h2>{s.label}</h2>
          <p>这里是「{s.label}」板块的内容占位，之后替换为正式内容。</p>
        </section>
      ))}
    </main>

    <script>
      // 滚动时自动高亮当前板块对应的导航项
      const links = document.querySelectorAll<HTMLAnchorElement>('nav a[data-target]');
      const byId = new Map([...links].map((a) => [a.dataset.target, a]));

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            links.forEach((a) => a.classList.remove('active'));
            byId.get(entry.target.id)?.classList.add('active');
          }
        },
        // 以视口垂直中线附近作为判定带，板块进入该区域即视为“当前板块”
        { rootMargin: '-45% 0px -55% 0px' }
      );

      document.querySelectorAll('main section').forEach((s) => observer.observe(s));
    </script>

    <style>
      :root {
        --nav-h: 56px;
        --accent: #6366f1;
      }
      * {
        margin: 0;
        box-sizing: border-box;
      }
      html {
        /* 声明页面为浅色配色，避免浏览器自动深色模式强制反色 */
        color-scheme: light;
        scroll-behavior: smooth;
        /* 锚点定位时预留顶栏高度，避免标题被顶栏遮住 */
        scroll-padding-top: var(--nav-h);
      }
      body {
        font-family: system-ui, sans-serif;
        color: #1f2937;
        background: #fff;
      }

      .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--nav-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #e5e7eb;
        z-index: 10;
      }
      .brand {
        font-weight: 700;
      }
      nav {
        display: flex;
        gap: 8px;
      }
      nav a {
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        color: #4b5563;
        transition: color 0.2s, background 0.2s;
      }
      nav a:hover {
        color: var(--accent);
      }
      nav a.active {
        color: #fff;
        background: var(--accent);
      }

      main section {
        min-height: 100vh;
        padding: calc(var(--nav-h) + 40px) 24px 40px;
        max-width: 800px;
        margin: 0 auto;
      }
      main section:nth-of-type(even) {
        background: #f9fafb;
        max-width: none;
      }
      main section h2 {
        font-size: 2rem;
        margin-bottom: 16px;
      }
    </style>
  </body>
</html>
