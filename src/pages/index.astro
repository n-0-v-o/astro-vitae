---
// 单页个人主页：顶栏 + 4 个板块，全页滚动锁定 + 视频播放
const sections = [
  { id: 'about', label: '关于我' },
  { id: 'skills', label: '技能' },
  { id: 'projects', label: '项目' },
  { id: 'contact', label: '联系' },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>我的个人主页</title>
  </head>
  <body>
    <header class="navbar">
      <span class="brand">My Home</span>
      <nav>
        {sections.map((s) => (
          <a href={`#${s.id}`} data-target={s.id}>{s.label}</a>
        ))}
      </nav>
    </header>

    <main>
      {sections.map((s, i) => (
        <section id={s.id} data-index={i}>
          <div class="section-content">
            <h2>{s.label}</h2>
            <p>这里是「{s.label}」板块的内容占位，之后替换为正式内容。</p>
          </div>
          {/* 第一部分：隐藏视频，用于提取帧作为背景 */}
          {i === 0 && (
            <video
              id="bg-video"
              src="/astro-vitae/菜单.mp4"
              muted
              preload="auto"
              playsinline
              class="bg-video"
            />
          )}
        </section>
      ))}
    </main>

    {/* 视频播放过渡层 */}
    <div id="video-overlay" class="video-overlay">
      <video
        id="transition-video"
        src="/astro-vitae/菜单.mp4"
        muted
        preload="auto"
        playsinline
      />
    </div>

    {/* Canvas 用于提取视频帧 */}
    <canvas id="frame-canvas" style="display:none"></canvas>

    <script>
      // ===== 全页滚动锁定 =====
      let currentSection = 0;
      const totalSections = 4;
      let isScrolling = false;

      const sections = document.querySelectorAll<HTMLElement>('main section');
      const links = document.querySelectorAll<HTMLAnchorElement>('nav a[data-target]');
      const byId = new Map([...links].map((a) => [a.dataset.target, a]));

      // 高亮导航项
      function highlightNav(index: number) {
        links.forEach((a) => a.classList.remove('active'));
        const targetId = sections[index]?.id;
        byId.get(targetId)?.classList.add('active');
      }

      // 视频过渡相关
      const videoOverlay = document.getElementById('video-overlay')!;
      const transitionVideo = document.getElementById('transition-video') as HTMLVideoElement;
      let lastSection = 0;

      // 检查是否需要播放视频过渡
      function checkVideoTransition(newSection: number) {
        // 从第一部分到第二部分：正向播放视频
        if (lastSection === 0 && newSection === 1) {
          playTransitionVideo();
        }
        // 从第二部分回到第一部分：倒放视频
        if (lastSection === 1 && newSection === 0) {
          playTransitionVideoReverse();
        }
        lastSection = newSection;
      }

      // 正向播放过渡视频
      function playTransitionVideo() {
        videoOverlay.classList.add('active');
        transitionVideo.currentTime = 0;
        transitionVideo.play();

        transitionVideo.addEventListener('ended', function onEnd() {
          transitionVideo.removeEventListener('ended', onEnd);
          videoOverlay.classList.remove('active');
        }, { once: true });
      }

      // 倒放过渡视频
      function playTransitionVideoReverse() {
        videoOverlay.classList.add('active');
        transitionVideo.currentTime = transitionVideo.duration;

        const reverseInterval = setInterval(() => {
          if (transitionVideo.currentTime <= 0.1) {
            clearInterval(reverseInterval);
            videoOverlay.classList.remove('active');
            return;
          }
          transitionVideo.currentTime -= 0.05;
        }, 30);
      }

      // 滚动到指定板块
      function scrollToSection(index: number) {
        if (index < 0 || index >= totalSections || isScrolling) return;
        isScrolling = true;

        // 先检查视频过渡
        checkVideoTransition(index);

        currentSection = index;
        sections[index].scrollIntoView({ behavior: 'smooth' });
        highlightNav(index);

        // 滚动动画结束后解锁
        setTimeout(() => {
          isScrolling = false;
        }, 800);
      }

      // 拦截滚轮事件，实现全页锁定
      function handleWheel(e: WheelEvent) {
        e.preventDefault();
        if (isScrolling) return;

        if (e.deltaY > 0) {
          scrollToSection(currentSection + 1);
        } else if (e.deltaY < 0) {
          scrollToSection(currentSection - 1);
        }
      }
      window.addEventListener('wheel', handleWheel, { passive: false });

      // 支持键盘上下箭头
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'PageDown') {
          e.preventDefault();
          scrollToSection(currentSection + 1);
        } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
          e.preventDefault();
          scrollToSection(currentSection - 1);
        }
      });

      // 导航点击
      links.forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = a.dataset.target;
          const index = [...sections].findIndex((s) => s.id === targetId);
          if (index !== -1) scrollToSection(index);
        });
      });

      // 初始高亮
      highlightNav(0);

      // ===== 视频帧提取与背景设置 =====
      const bgVideo = document.getElementById('bg-video') as HTMLVideoElement;
      const canvas = document.getElementById('frame-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;

      // 提取视频帧
      function captureFrame(video: HTMLVideoElement, time: number): Promise<string> {
        return new Promise((resolve) => {
          video.currentTime = time;
          video.addEventListener('seeked', function onSeeked() {
            video.removeEventListener('seeked', onSeeked);
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0);
            resolve(canvas.toDataURL('image/jpeg', 0.9));
          }, { once: true });
        });
      }

      // 视频加载后提取第一帧和最后一帧作为背景
      bgVideo.addEventListener('loadeddata', async () => {
        // 提取第一帧（time=0）作为第一部分背景
        const firstFrame = await captureFrame(bgVideo, 0);
        sections[0].style.backgroundImage = `url(${firstFrame})`;
        sections[0].style.backgroundSize = 'cover';
        sections[0].style.backgroundPosition = 'center';

        // 提取最后一帧作为第二部分背景
        const lastFrame = await captureFrame(bgVideo, bgVideo.duration - 0.1);
        sections[1].style.backgroundImage = `url(${lastFrame})`;
        sections[1].style.backgroundSize = 'cover';
        sections[1].style.backgroundPosition = 'center';
      });
    </script>

    <style>
      :root {
        --nav-h: 56px;
        --accent: #6366f1;
      }
      * {
        margin: 0;
        box-sizing: border-box;
      }
      html {
        color-scheme: light;
        overflow: hidden;
      }
      body {
        font-family: system-ui, sans-serif;
        color: #1f2937;
        background: #fff;
        overflow: hidden;
      }

      .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--nav-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #e5e7eb;
        z-index: 100;
      }
      .brand {
        font-weight: 700;
      }
      nav {
        display: flex;
        gap: 8px;
      }
      nav a {
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        color: #4b5563;
        transition: color 0.2s, background 0.2s;
      }
      nav a:hover {
        color: var(--accent);
      }
      nav a.active {
        color: #fff;
        background: var(--accent);
      }

      main {
        height: 100vh;
        overflow: hidden;
      }

      main section {
        height: 100vh;
        padding: calc(var(--nav-h) + 40px) 24px 40px;
        max-width: 800px;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .section-content {
        position: relative;
        z-index: 2;
        text-align: center;
      }

      main section h2 {
        font-size: 2.5rem;
        margin-bottom: 16px;
      }

      /* 有背景图的部分文字改为白色 */
      #about .section-content,
      #skills .section-content {
        color: #fff;
        text-shadow: 0 2px 8px rgba(0,0,0,0.5);
      }
      #about .section-content p,
      #skills .section-content p {
        text-shadow: 0 1px 4px rgba(0,0,0,0.3);
      }

      /* 第三、四部分保持原样式 */
      #projects,
      #contact {
        background: #f9fafb;
        max-width: none;
      }

      /* 背景视频（隐藏，仅用于提取帧） */
      .bg-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        opacity: 0;
        pointer-events: none;
      }

      /* 过渡视频覆盖层 */
      .video-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.85);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }

      .video-overlay.active {
        opacity: 1;
        pointer-events: auto;
      }

      .video-overlay video {
        max-width: 80%;
        max-height: 80%;
        border-radius: 8px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5);
      }
    </style>
  </body>
</html>
