---
// 单页个人主页：PPT式板块切换 + 视频过渡动画
const sections = [
  { id: 'about', label: '关于我' },
  { id: 'skills', label: '技能' },
  { id: 'projects', label: '项目' },
  { id: 'contact', label: '联系' },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>我的个人主页</title>
  </head>
  <body>
    <header class="navbar">
      <span class="brand">My Home</span>
      <nav>
        {sections.map((s) => (
          <a href={`#${s.id}`} data-target={s.id}>{s.label}</a>
        ))}
      </nav>
    </header>

    <main>
      {sections.map((s, i) => (
        <section id={s.id} data-index={i} class={i === 0 ? 'active' : ''}>
          <div class="section-content">
            <h2>{s.label}</h2>
            <p>这里是「{s.label}」板块的内容占位，之后替换为正式内容。</p>
          </div>
        </section>
      ))}

      {/* 视频过渡层：在第一部分和第二部分之间播放 */}
      <div id="video-transition" class="video-transition">
        <video
          id="transition-video"
          src="/astro-vitae/菜单.mp4"
          muted
          preload="auto"
          playsinline
        />
      </div>
    </main>

    {/* Canvas 用于提取视频帧 */}
    <canvas id="frame-canvas" style="display:none"></canvas>

    <script>
      // ===== 板块管理 =====
      let currentSection = 0;
      const totalSections = 4;
      let isAnimating = false;

      const sections = document.querySelectorAll<HTMLElement>('main section');
      const links = document.querySelectorAll<HTMLAnchorElement>('nav a[data-target]');
      const byId = new Map([...links].map((a) => [a.dataset.target, a]));

      // 视频过渡元素
      const videoTransition = document.getElementById('video-transition')!;
      const transitionVideo = document.getElementById('transition-video') as HTMLVideoElement;
      const canvas = document.getElementById('frame-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;

      // 高亮导航项
      function highlightNav(index: number) {
        links.forEach((a) => a.classList.remove('active'));
        const targetId = sections[index]?.id;
        byId.get(targetId)?.classList.add('active');
      }

      // 显示指定板块
      function showSection(index: number) {
        sections.forEach((s) => s.classList.remove('active'));
        sections[index].classList.add('active');
        highlightNav(index);
      }

      // 提取视频帧
      function captureFrame(video: HTMLVideoElement, time: number): Promise<string> {
        return new Promise((resolve) => {
          video.currentTime = time;
          video.addEventListener('seeked', function onSeeked() {
            video.removeEventListener('seeked', onSeeked);
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0);
            resolve(canvas.toDataURL('image/jpeg', 0.9));
          }, { once: true });
        });
      }

      // 设置第一部分和第二部分的背景
      async function setupBackgrounds() {
        // 等待视频加载
        await new Promise<void>((resolve) => {
          if (transitionVideo.readyState >= 2) {
            resolve();
          } else {
            transitionVideo.addEventListener('loadeddata', () => resolve(), { once: true });
          }
        });

        // 提取第一帧作为第一部分背景
        const firstFrame = await captureFrame(transitionVideo, 0);
        sections[0].style.backgroundImage = `url(${firstFrame})`;
        sections[0].style.backgroundSize = 'cover';
        sections[0].style.backgroundPosition = 'center';

        // 提取最后一帧作为第二部分背景
        const lastFrame = await captureFrame(transitionVideo, transitionVideo.duration - 0.1);
        sections[1].style.backgroundImage = `url(${lastFrame})`;
        sections[1].style.backgroundSize = 'cover';
        sections[1].style.backgroundPosition = 'center';
      }

      // 初始化背景
      setupBackgrounds();

      // ===== PPT式切换动画 =====

      // 从第一部分切换到第二部分（正向播放视频）
      async function transitionForward() {
        if (isAnimating) return;
        isAnimating = true;

        // 1. 隐藏第一部分文字
        sections[0].classList.add('hiding');

        // 2. 等待文字隐藏动画完成
        await new Promise((r) => setTimeout(r, 500));

        // 3. 显示视频过渡层并播放视频
        videoTransition.classList.add('active');
        transitionVideo.currentTime = 0;
        transitionVideo.play();

        // 4. 等待视频播放完成
        await new Promise<void>((resolve) => {
          transitionVideo.addEventListener('ended', () => resolve(), { once: true });
        });

        // 5. 隐藏视频过渡层
        videoTransition.classList.remove('active');

        // 6. 切换到第二部分
        currentSection = 1;
        showSection(1);

        // 7. 显示第二部分文字（带淡入效果）
        sections[1].classList.add('showing');
        await new Promise((r) => setTimeout(r, 500));
        sections[1].classList.remove('showing');

        // 清理第一部分的状态
        sections[0].classList.remove('hiding');

        isAnimating = false;
      }

      // 从第二部分切换回第一部分（倒放视频）
      async function transitionBackward() {
        if (isAnimating) return;
        isAnimating = true;

        // 1. 隐藏第二部分文字
        sections[1].classList.add('hiding');

        // 2. 等待文字隐藏动画完成
        await new Promise((r) => setTimeout(r, 500));

        // 3. 显示视频过渡层并倒放视频
        videoTransition.classList.add('active');
        transitionVideo.currentTime = transitionVideo.duration;

        // 倒放视频
        const reversePromise = new Promise<void>((resolve) => {
          const interval = setInterval(() => {
            if (transitionVideo.currentTime <= 0.1) {
              clearInterval(interval);
              resolve();
              return;
            }
            transitionVideo.currentTime -= 0.05;
          }, 30);
        });

        await reversePromise;

        // 4. 隐藏视频过渡层
        videoTransition.classList.remove('active');

        // 5. 切换到第一部分
        currentSection = 0;
        showSection(0);

        // 6. 显示第一部分文字
        sections[0].classList.add('showing');
        await new Promise((r) => setTimeout(r, 500));
        sections[0].classList.remove('showing');

        // 清理第二部分的状态
        sections[1].classList.remove('hiding');

        isAnimating = false;
      }

      // 普通板块切换（无动画）
      function switchSection(index: number) {
        if (isAnimating || index === currentSection) return;
        currentSection = index;
        showSection(index);
      }

      // ===== 事件处理 =====

      // 滚轮事件
      function handleWheel(e: WheelEvent) {
        e.preventDefault();
        if (isAnimating) return;

        const goingDown = e.deltaY > 0;

        // 在第一部分，向下滚动 -> 播放视频过渡到第二部分
        if (currentSection === 0 && goingDown) {
          transitionForward();
          return;
        }

        // 在第二部分，向上滚动 -> 倒放视频回到第一部分
        if (currentSection === 1 && !goingDown) {
          transitionBackward();
          return;
        }

        // 其他板块之间的普通切换
        if (goingDown && currentSection < totalSections - 1) {
          switchSection(currentSection + 1);
        } else if (!goingDown && currentSection > 0) {
          switchSection(currentSection - 1);
        }
      }
      window.addEventListener('wheel', handleWheel, { passive: false });

      // 键盘事件
      window.addEventListener('keydown', (e) => {
        if (isAnimating) return;

        if (e.key === 'ArrowDown' || e.key === 'PageDown') {
          e.preventDefault();
          if (currentSection === 0) {
            transitionForward();
          } else if (currentSection < totalSections - 1) {
            switchSection(currentSection + 1);
          }
        } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
          e.preventDefault();
          if (currentSection === 1) {
            transitionBackward();
          } else if (currentSection > 0) {
            switchSection(currentSection - 1);
          }
        }
      });

      // 导航点击
      links.forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = a.dataset.target;
          const index = [...sections].findIndex((s) => s.id === targetId);
          if (index !== -1) {
            // 如果涉及第一部分和第二部分之间的切换，使用动画
            if (currentSection === 0 && index === 1) {
              transitionForward();
            } else if (currentSection === 1 && index === 0) {
              transitionBackward();
            } else {
              switchSection(index);
            }
          }
        });
      });

      // 初始高亮
      highlightNav(0);
    </script>

    <style>
      :root {
        --nav-h: 56px;
        --accent: #6366f1;
      }
      * {
        margin: 0;
        box-sizing: border-box;
      }
      html {
        color-scheme: light;
        overflow: hidden;
      }
      body {
        font-family: system-ui, sans-serif;
        color: #1f2937;
        background: #000;
        overflow: hidden;
      }

      .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--nav-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #e5e7eb;
        z-index: 100;
      }
      .brand {
        font-weight: 700;
      }
      nav {
        display: flex;
        gap: 8px;
      }
      nav a {
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        color: #4b5563;
        transition: color 0.2s, background 0.2s;
      }
      nav a:hover {
        color: var(--accent);
      }
      nav a.active {
        color: #fff;
        background: var(--accent);
      }

      main {
        height: 100vh;
        overflow: hidden;
        position: relative;
      }

      main section {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        padding: calc(var(--nav-h) + 40px) 24px 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
        background-color: #f9fafb;
        background-size: cover;
        background-position: center;
      }

      main section.active {
        opacity: 1;
        visibility: visible;
      }

      .section-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 800px;
        transition: opacity 0.5s ease, transform 0.5s ease;
      }

      /* 隐藏文字动画 */
      main section.hiding .section-content {
        opacity: 0;
        transform: translateY(-20px);
      }

      /* 显示文字动画 */
      main section.showing .section-content {
        opacity: 0;
        transform: translateY(20px);
      }

      main section.active:not(.hiding) .section-content {
        opacity: 1;
        transform: translateY(0);
      }

      main section h2 {
        font-size: 2.5rem;
        margin-bottom: 16px;
      }

      /* 第一部分和第二部分：有背景图时文字为白色 */
      #about .section-content,
      #skills .section-content {
        color: #fff;
        text-shadow: 0 2px 8px rgba(0,0,0,0.5);
      }
      #about .section-content p,
      #skills .section-content p {
        text-shadow: 0 1px 4px rgba(0,0,0,0.3);
      }

      /* 视频过渡层 */
      .video-transition {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 50;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
      }

      .video-transition.active {
        opacity: 1;
        visibility: visible;
      }

      .video-transition video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    </style>
  </body>
</html>
