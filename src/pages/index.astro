---
// 单页个人主页：顶栏 + 4 个板块，全页滚动锁定 + 视频背景过渡
const sections = [
  { id: 'about', label: '关于我' },
  { id: 'skills', label: '技能' },
  { id: 'projects', label: '项目' },
  { id: 'contact', label: '联系' },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>我的个人主页</title>
  </head>
  <body>
    <header class="navbar">
      <span class="brand">My Home</span>
      <nav>
        {sections.map((s) => (
          <a href={`#${s.id}`} data-target={s.id}>{s.label}</a>
        ))}
      </nav>
    </header>

    <main>
      {sections.map((s, i) => (
        <section id={s.id} data-index={i}>
          <div class="section-content">
            <h2>{s.label}</h2>
            <p>这里是「{s.label}」板块的内容占位，之后替换为正式内容。</p>
          </div>
          {/* 视频背景元素：第一部分和第二部分各一个 */}
          {(i === 0 || i === 1) && (
            <video
              class="bg-video"
              data-section={i}
              src="/astro-vitae/菜单.mp4"
              muted
              preload="auto"
              playsinline
            />
          )}
        </section>
      ))}
    </main>

    {/* Canvas 用于提取视频帧 */}
    <canvas id="frame-canvas" style="display:none"></canvas>

    <script>
      // ===== 全页滚动锁定 =====
      let currentSection = 0;
      const totalSections = 4;
      let isScrolling = false;

      const sections = document.querySelectorAll<HTMLElement>('main section');
      const links = document.querySelectorAll<HTMLAnchorElement>('nav a[data-target]');
      const byId = new Map([...links].map((a) => [a.dataset.target, a]));

      // 高亮导航项
      function highlightNav(index: number) {
        links.forEach((a) => a.classList.remove('active'));
        const targetId = sections[index]?.id;
        byId.get(targetId)?.classList.add('active');
      }

      // 获取视频元素
      const video0 = document.querySelector<HTMLVideoElement>('.bg-video[data-section="0"]')!;
      const video1 = document.querySelector<HTMLVideoElement>('.bg-video[data-section="1"]')!;
      let lastSection = 0;

      // 检查是否需要播放视频过渡
      function checkVideoTransition(newSection: number) {
        // 从第一部分到第二部分：播放第一部分的视频背景
        if (lastSection === 0 && newSection === 1) {
          playVideoForward();
        }
        // 从第二部分回到第一部分：倒放第一部分的视频
        if (lastSection === 1 && newSection === 0) {
          playVideoReverse();
        }
        lastSection = newSection;
      }

      // 正向播放视频（在第一部分作为背景）
      function playVideoForward() {
        video0.classList.add('playing');
        video0.currentTime = 0;
        video0.play();

        video0.addEventListener('ended', function onEnd() {
          video0.removeEventListener('ended', onEnd);
          video0.classList.remove('playing');
        }, { once: true });
      }

      // 倒放视频（从第二部分返回第一部分时）
      function playVideoReverse() {
        video0.classList.add('playing');
        video0.currentTime = video0.duration;

        const reverseInterval = setInterval(() => {
          if (video0.currentTime <= 0.1) {
            clearInterval(reverseInterval);
            video0.classList.remove('playing');
            return;
          }
          video0.currentTime -= 0.05;
        }, 30);
      }

      // 滚动到指定板块
      function scrollToSection(index: number) {
        if (index < 0 || index >= totalSections || isScrolling) return;
        isScrolling = true;

        // 检查视频过渡
        checkVideoTransition(index);

        currentSection = index;
        sections[index].scrollIntoView({ behavior: 'smooth' });
        highlightNav(index);

        // 滚动动画结束后解锁
        setTimeout(() => {
          isScrolling = false;
        }, 800);
      }

      // 拦截滚轮事件
      function handleWheel(e: WheelEvent) {
        e.preventDefault();
        if (isScrolling) return;

        if (e.deltaY > 0) {
          scrollToSection(currentSection + 1);
        } else if (e.deltaY < 0) {
          scrollToSection(currentSection - 1);
        }
      }
      window.addEventListener('wheel', handleWheel, { passive: false });

      // 键盘支持
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'PageDown') {
          e.preventDefault();
          scrollToSection(currentSection + 1);
        } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
          e.preventDefault();
          scrollToSection(currentSection - 1);
        }
      });

      // 导航点击
      links.forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = a.dataset.target;
          const index = [...sections].findIndex((s) => s.id === targetId);
          if (index !== -1) scrollToSection(index);
        });
      });

      // 初始高亮
      highlightNav(0);

      // ===== 视频帧提取与背景设置 =====
      const canvas = document.getElementById('frame-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;

      // 提取视频帧
      function captureFrame(video: HTMLVideoElement, time: number): Promise<string> {
        return new Promise((resolve) => {
          video.currentTime = time;
          video.addEventListener('seeked', function onSeeked() {
            video.removeEventListener('seeked', onSeeked);
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0);
            resolve(canvas.toDataURL('image/jpeg', 0.9));
          }, { once: true });
        });
      }

      // 视频加载后提取帧作为静态背景
      video0.addEventListener('loadeddata', async () => {
        // 提取第一帧作为第一部分的静态背景
        const firstFrame = await captureFrame(video0, 0);
        sections[0].style.setProperty('--bg-image', `url(${firstFrame})`);

        // 提取最后一帧作为第二部分的静态背景
        const lastFrame = await captureFrame(video0, video0.duration - 0.1);
        sections[1].style.setProperty('--bg-image', `url(${lastFrame})`);
      });
    </script>

    <style>
      :root {
        --nav-h: 56px;
        --accent: #6366f1;
      }
      * {
        margin: 0;
        box-sizing: border-box;
      }
      html {
        color-scheme: light;
        overflow: hidden;
      }
      body {
        font-family: system-ui, sans-serif;
        color: #1f2937;
        background: #fff;
        overflow: hidden;
      }

      .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--nav-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #e5e7eb;
        z-index: 100;
      }
      .brand {
        font-weight: 700;
      }
      nav {
        display: flex;
        gap: 8px;
      }
      nav a {
        padding: 6px 14px;
        border-radius: 6px;
        text-decoration: none;
        color: #4b5563;
        transition: color 0.2s, background 0.2s;
      }
      nav a:hover {
        color: var(--accent);
      }
      nav a.active {
        color: #fff;
        background: var(--accent);
      }

      main {
        height: 100vh;
        overflow: hidden;
      }

      main section {
        height: 100vh;
        padding: calc(var(--nav-h) + 40px) 24px 40px;
        max-width: 800px;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .section-content {
        position: relative;
        z-index: 2;
        text-align: center;
      }

      main section h2 {
        font-size: 2.5rem;
        margin-bottom: 16px;
      }

      /* 有背景的部分文字改为白色 */
      #about .section-content,
      #skills .section-content {
        color: #fff;
        text-shadow: 0 2px 8px rgba(0,0,0,0.5);
      }
      #about .section-content p,
      #skills .section-content p {
        text-shadow: 0 1px 4px rgba(0,0,0,0.3);
      }

      /* 第三、四部分 */
      #projects,
      #contact {
        background: #f9fafb;
        max-width: none;
      }

      /* 第一部分和第二部分：使用伪元素作为背景层 */
      #about,
      #skills {
        --bg-image: none;
      }

      #about::before,
      #skills::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: var(--bg-image);
        background-size: cover;
        background-position: center;
        z-index: 0;
      }

      /* 视频背景 */
      .bg-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }

      /* 视频播放时显示 */
      .bg-video.playing {
        opacity: 1;
      }
    </style>
  </body>
</html>
